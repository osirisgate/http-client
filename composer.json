{
    "name": "osirisgate/http-client",
    "type": "library",
    "description": "Provides powerful and flexible methods to fetch HTTP resources synchronously or asynchronously.",
    "keywords": ["http"],
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "symfony/http-client": "*",
        "osirisgate/core": "^1.0"
    },
    "require-dev": {
        "symfony/var-dumper": "v7.2.6",
        "phpunit/phpunit": "12.1.5",
        "friendsofphp/php-cs-fixer": "dev-master",
        "phpstan/phpstan": "2.1.15",
        "symplify/easy-coding-standard": "^12.5",
        "squizlabs/php_codesniffer": "3.4.2"
    },
    "autoload": {
        "psr-4": {
            "Osirisgate\\Component\\HttpClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Osirisgate\\Component\\HttpClient\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Ulrich Geraud AHOGLA",
            "email": "developer@osirisgate.com"
        }
    ],
    "scripts": {
        "phpcs-fix": "PHP_CS_FIXER_IGNORE_ENV=1 vendor/bin/php-cs-fixer fix --allow-risky=yes --path-mode=intersection --config=.php-cs-fixer.dist.php src/",
        "phpstan": "vendor/bin/phpstan analyse -c phpstan.dist.neon -l 9 src/"
    }
}
